{
  "name": "karthik-bikego",
  "version": "1.0.0",
  "description": "Karthik-BikeGo - Full-Stack Concurrency-Safe Bike Rental Platform",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "build": "npm --prefix frontend run build",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "lint:frontend": "npm --prefix frontend run lint",
    "seed": "npm --prefix backend run seed",
    "test:concurrency": "npm --prefix backend run test:concurrency",
    "test:api": "npm --prefix backend run test:api",
    "test:qa": "npm --prefix backend run test:qa"
  },
  "keywords": [
    "react",
    "vite",
    "express",
    "mongodb",
    "aws",
    "amplify",
    "ec2"
  ],
