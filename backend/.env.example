# ========================================================
# Karthik-BikeGo Backend Environment Configuration
# Region: Asia Pacific (Mumbai) ap-south-1
# ========================================================

# Server Network Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/bikego?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-url>/bikego?retryWrites=true&w=majority

# JWT Authentication Secret (Use a strong random 256-bit string in production)
JWT_SECRET=your_super_secret_jwt_key_generate_with_openssl_rand_hex_32

# CORS Allowed Origins
# For local dev: http://localhost:5173
# For AWS Amplify: https://master.xxxxxxx.amplifyapp.com or https://yourcustomdomain.com
# Use comma-separated list for multiple origins
CORS_ORIGIN=http://localhost:5173,https://master.xxxxxxx.amplifyapp.com

# Email / Notification Configuration (Optional)
EMAIL_USERNAME=your_email@domain.com
EMAIL_PASSWORD=your_app_password
